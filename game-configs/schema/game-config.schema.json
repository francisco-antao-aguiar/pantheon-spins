{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pantheon-spins.local/schema/game-config.schema.json",
  "title": "Pantheon Spins game config",
  "description": "One slot game's maths and metadata. The server validates the same rules on load (server/internal/games/config.go).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "theme", "layout", "reels", "rows", "volatility", "betLevels", "defaultBet", "targetRtp", "symbols", "reelSets"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$", "description": "Must match the file name." },
    "name": { "type": "string", "minLength": 1 },
    "theme": { "type": "string" },
    "description": { "type": "string" },
    "layout": { "enum": ["ways", "lines", "cluster", "megaways", "hex"] },
    "reels": { "type": "integer", "minimum": 1, "maximum": 12 },
    "rows": { "type": "integer", "minimum": 1, "maximum": 12, "description": "Rows, or the maximum rows for variable-height layouts." },
    "heights": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "description": "Per-reel heights for ragged grids (e.g. a honeycomb 5,4,5,4,5). Defaults to rows on every reel."
    },
    "volatility": { "enum": ["low", "medium", "high", "very_high"] },
    "tags": { "type": "array", "items": { "enum": ["new", "hot"] }, "uniqueItems": true },
    "betLevels": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 20, "multipleOf": 20 },
      "description": "Strictly increasing. Multiples of 20 so every pay (a multiple of 0.05× bet) is a whole number of Coins."
    },
    "defaultBet": { "type": "integer", "description": "One of betLevels." },
    "targetRtp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number", "minimum": 0.5, "exclusiveMaximum": 1 },
        "max": { "type": "number", "minimum": 0.5, "exclusiveMaximum": 1 }
      }
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 254,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
          "name": { "type": "string" },
          "kind": {
            "enum": ["low", "high", "wild", "scatter", "special"],
            "description": "wild substitutes for low/high symbols; scatter pays or triggers anywhere; special is game-specific and never pays directly."
          },
          "pays": {
            "type": "object",
            "description": "Count (reels for ways/lines, cluster size for clusters) → bet multiple, in steps of 0.05. A count pays the entry for the largest key at or below it.",
            "propertyNames": { "pattern": "^[1-9][0-9]?$|^100$" },
            "additionalProperties": { "type": "number", "minimum": 0, "multipleOf": 0.05 }
          }
        }
      }
    },
    "reelSets": {
      "type": "object",
      "required": ["base"],
      "description": "Named sets (base, free, …) of per-reel symbol weights. Each cell is drawn independently from its reel's weights.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "lines": {
      "type": "array",
      "description": "Paylines for the lines layout: the row used on each reel.",
      "items": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
    },
    "params": {
      "type": "object",
      "description": "Game-specific settings (features, bonus maths). Each game package documents and strictly decodes its own params."
    }
  }
}
