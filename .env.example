# Copy to .env to override docker-compose defaults.

# Public URL of the web app (used in reset emails and OAuth redirects).
APP_BASE_URL=http://localhost:5173

# At least 32 bytes. Generate one with: openssl rand -hex 32
CSRF_SECRET=

# true when served over HTTPS.
COOKIE_SECURE=false

LOG_LEVEL=info

# Optional Google sign-in. Leave empty to disable.
# Authorized redirect URI in Google Cloud: http://localhost:5173/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# Host ports (change if something else already uses them).
POSTGRES_PORT=5432
REDIS_PORT=6379
SERVER_PORT=8080
WEB_PORT=5173
